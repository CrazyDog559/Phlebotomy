# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Service role key is SECRET (server-only). Used by the Stripe webhook to grant access.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ---- Stripe (Developers -> API keys) ----
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create (Developers -> Webhooks). Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- App ----
# Your deployed URL (no trailing slash). For local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
